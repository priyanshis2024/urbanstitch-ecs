<?xml version="1.0" encoding="UTF-8"?>

<!-- liquibase formatted xml -->
<!-- changeset Briskteq:users -->
<!-- comment make username field as nullable for the users table  -->

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro" 
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro 
        http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">
    <changeSet id="users-005" author="Briskteq">
        <dropNotNullConstraint tableName="users" columnName="username" columnDataType="VARCHAR(100)" schemaName="users"/>
        <rollback>
            <addNotNullConstraint tableName="users" columnName="username" columnDataType="VARCHAR(100)" schemaName="users"/>
        </rollback>
    </changeSet>
</databaseChangeLog>

