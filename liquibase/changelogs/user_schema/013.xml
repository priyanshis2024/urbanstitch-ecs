<?xml version="1.0" encoding="UTF-8"?>

<!-- Liquibase formatted XML -->
<!-- Changeset Briskteq:users -->
<!-- Comment: Add otp column in users table-->

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro" 
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro 
        http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">     
        
    <changeSet id="users-004" author="Briskteq">
        <addColumn schemaName= "users" tableName="users">
            <column name="otp" type="TEXT">
                <constraints nullable="true"/>
            </column>
        </addColumn>           
        <rollback>
            <dropColumn columnName="otp"
                        schemaName="users"
                        tableName="users">
            </dropColumn>
        </rollback>
    </changeSet>
</databaseChangeLog>