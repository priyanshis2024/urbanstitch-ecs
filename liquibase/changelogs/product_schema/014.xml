<?xml version="1.0" encoding="UTF-8"?>

<!-- Liquibase formatted XML -->
<!-- Changeset Briskteq:carts -->
<!-- Comment: Add forign key constraint to subproduct_id in carts table-->

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro" 
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro 
        http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

    <changeSet id="carts-002" author="Briskteq">
            <addForeignKeyConstraint 
                baseTableSchemaName="products"
                baseTableName="carts"
                baseColumnNames="subproduct_id"
                referencedTableName="subproducts"
                referencedColumnNames="id"
                referencedTableSchemaName="products" 
                constraintName="fk_subproduct"
                onDelete="CASCADE"/>
        <rollback>
            <dropForeignKeyConstraint 
                baseTableSchemaName="products"
                baseTableName="carts"
                constraintName="fk_subproduct"/>
        </rollback>
    </changeSet>
</databaseChangeLog>