<?xml version="1.0" encoding="UTF-8"?>

<!-- Liquibase formatted XML -->
<!-- Changeset Briskteq:orders -->
<!-- Comment: Add customer id in orders table -->

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro" 
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro 
        http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

    <changeSet id="orders-002" author="Briskteq">
        <addColumn schemaName= "products" tableName="orders">
            <column name="customer_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </addColumn>           
        <rollback>
            <dropColumn columnName="customer_id"
                        schemaName="products"
                        tableName="orders">
            </dropColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
