<?xml version="1.0" encoding="UTF-8"?>

<!-- Liquibase formatted XML -->
<!-- Changeset Briskteq:payments -->
<!-- Comment: Add transaction id and payment method column in payments table -->

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro" 
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro 
        http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

    <changeSet id="payments-003" author="Briskteq">
        <addColumn schemaName= "products" tableName="payments">
            <column name="transaction_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="payment_method" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </addColumn>           
        <rollback>
            <dropColumn columnName="transaction_id"
                        schemaName="products"
                        tableName="payments">
            </dropColumn>
            <dropColumn columnName="payment_method"
                        schemaName="products"
                        tableName="payments">
            </dropColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
